# ============================================================================
# especiacao-mercurio-ihm.service — unidade systemd (escopo system)
#
# Implantação padrão (Raspberry Pi / DietPi) — raiz e usuário preenchidos:
#   raiz   : /home/dietpi/especiacao-mercurio-frontend-back-end
#   usuário: dietpi
#
# Instalação (detalhes na seção "Serviço systemd" do README.md):
#   cd /home/dietpi/especiacao-mercurio-frontend-back-end
#   sudo cp scripts/systemd/especiacao-mercurio-ihm.service.template \
#           /etc/systemd/system/especiacao-mercurio-ihm.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now especiacao-mercurio-ihm
#
# Para outra raiz/usuário, ajuste: Documentation, User, Group, WorkingDirectory,
# ExecStartPre, ExecStart, ExecStop e PIDFile.
# ============================================================================

[Unit]
Description=Sistema de Especiação de Mercúrio — Backend (FastAPI) + IHM Web
Documentation=file:///home/dietpi/especiacao-mercurio-frontend-back-end/README.md
After=network.target

[Service]
# start.sh daemoniza o backend com nohup e registra o PID em logs/backend.pid,
# portanto o systemd deve aguardar o término do script (Type=forking).
Type=forking

User=dietpi
# Ajuste se o grupo primário do usuário tiver nome diferente de dietpi.
Group=dietpi
# Necessário para acessar a serial do Arduino (/dev/ttyUSB0 ou /dev/ttyACM0).
SupplementaryGroups=dialout
WorkingDirectory=/home/dietpi/especiacao-mercurio-frontend-back-end

# Variáveis lidas por scripts/start.sh e pelo backend (backend/app/run.py).
# Podem ser sobrescritas por drop-in (systemctl edit ...) ou pelo arquivo
# opcional /etc/default/especiacao-mercurio-ihm (prefixo "-" = arquivo opcional).
Environment=SERIAL_PORT=/dev/ttyUSB0
Environment=PORT=8000
Environment=HOST=0.0.0.0
# Environment=PATH=/usr/local/bin:/usr/bin:/bin   # necessário apenas com --dev (npm)
EnvironmentFile=-/etc/default/especiacao-mercurio-ihm

# Remove PIDs órfãos deixados por uma execução manual anterior de start.sh
# (o prefixo "-" faz o systemd ignorar falhas deste comando).
ExecStartPre=-/home/dietpi/especiacao-mercurio-frontend-back-end/scripts/stop.sh
ExecStart=/home/dietpi/especiacao-mercurio-frontend-back-end/scripts/start.sh
ExecStop=/home/dietpi/especiacao-mercurio-frontend-back-end/scripts/stop.sh
PIDFile=/home/dietpi/especiacao-mercurio-frontend-back-end/logs/backend.pid

# A primeira execução pode criar o venv do backend e instalar dependências.
TimeoutStartSec=600
# Encerra todos os processos do cgroup (backend e, com --dev, o servidor Vite).
KillMode=control-group
TimeoutStopSec=30

# Reinicia somente em falha (crash do backend), não em parada explícita.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
